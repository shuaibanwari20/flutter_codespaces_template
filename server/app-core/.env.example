APP_NAME="حضور قابله"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kabul
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=midwife_attendance
# NOTE for SQLite: if you set DB_CONNECTION=sqlite, DELETE the DB_DATABASE line above
# (Laravel then uses database/database.sqlite automatically).
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# Attendance rules (Asia/Kabul server time)
WORK_START=08:00
LATE_UNTIL=08:30
MAX_GPS_ACCURACY=50

# Admin panel seeded login: admin@anwari.tech / admin1234
